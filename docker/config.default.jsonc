{
    // Docker dev keeps provider credentials local in docker/config/config.jsonc.
    // install.templates.ts copies this file only when config.jsonc is missing,
    // so existing API keys are never replaced by automation.
    "model": {
        "activeProvider": "openai",
        "activeModel": "gpt-5.5",
        "providers": {
            "openai": {
                "baseUrl": "https://api.openai.com/v1",
                "apiKey": "",
            },
        },
    },
    "memory": {
        "enabled": true,
        "working": {
            "backend": "local",
        },
        "crystal": {
            "enabled": true,
            "backend": "local",
        },
    },
}
