{
    // EN: Synapse coordination prompt package version.
    // ZH: Synapse 协调提示词包版本。
    "version": 1,
    // EN: Human-readable description.
    // ZH: 面向人的描述。
    "description": "Cortex coordination prompts for multi-agent understanding.",
    // EN: Files loaded into ordinary coordinator messages.
    // ZH: 加载进普通协调器消息的文件。
    "prompt": {
        "sections": [
            "plan",
            "synthesis"
        ]
    },
    // EN: Files and write limits for cortex prompts.
    // ZH: 皮层提示词使用的文件和写入限制。
    "protocolPackage": {
        // EN: Files that runtime updates may modify.
        // ZH: 运行时更新允许修改的文件。
        "editable": [],
        // EN: Files that can be read for rules but must not be rewritten.
        // ZH: 可读取规则但禁止重写的文件。
        "locked": [
            "plan.md",
            "synthesis.md"
        ],
        // EN: Files not loaded into ordinary coordinator messages.
        // ZH: 不加载进普通协调器消息的文件。
        "runtimeIgnored": [
            "config.jsonc",
            "plan.zh.cn.md",
            "synthesis.zh.cn.md"
        ],
        // EN: XML documents supplied when planning prompt updates.
        // ZH: 规划提示词更新时提供的 XML 文档。
        "context": {
            // EN: Root XML tag.
            // ZH: XML 根标签。
            "root": "prompt_package",
            // EN: Ordered documents included for update planning.
            // ZH: 更新规划时按顺序包含的文档。
            "blocks": [
                {
                    "key": "config",
                    "tag": "document",
                    "file": "config.jsonc",
                    "role": "policy",
                    "note": "file list and write limits"
                },
                {
                    "key": "plan",
                    "tag": "document",
                    "file": "plan.md",
                    "role": "rules",
                    "note": "how to plan multi-agent coordination"
                },
                {
                    "key": "synthesis",
                    "tag": "document",
                    "file": "synthesis.md",
                    "role": "rules",
                    "note": "how to synthesize worker understandings"
                }
            ]
        }
    }
}
