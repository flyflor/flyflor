{
  "version": 1,
  "description": "Tool definitions exposed to the model.",
  "prompt": {
    "sections": ["ask", "confirm", "filesystem", "shell", "execute"]
  },
  "tools": [
    {
      "key": "ask",
      "name": "ask",
      "file": "ask.md",
      "risk": "interaction",
      "parameters": {
        "type": "object",
        "properties": {
          "question": { "type": "string" },
          "options": { "type": "array" }
        },
        "required": ["question", "options"]
      }
    },
    {
      "key": "confirm",
      "name": "confirm",
      "file": "confirm.md",
      "risk": "interaction",
      "parameters": {
        "type": "object",
        "properties": {
          "question": { "type": "string" },
          "recommended": { "type": "boolean" }
        },
        "required": ["question", "recommended"]
      }
    },
    {
      "key": "filesystem",
      "name": "filesystem",
      "file": "filesystem.md",
      "risk": "destructive",
      "parameters": {
        "type": "object",
        "properties": {
          "action": { "type": "string", "enum": ["read", "write", "edit", "delete"] },
          "cwd": { "type": "string" },
          "path": { "type": "string" },
          "offsetLines": { "type": "number" },
          "limitLines": { "type": "number" },
          "limitBytes": { "type": "number" },
          "content": { "type": "string" },
          "oldText": { "type": "string" },
          "newText": { "type": "string" }
        },
        "required": ["action", "path"]
      }
    },
    {
      "key": "shell",
      "name": "shell",
      "file": "shell.md",
      "risk": "external",
      "parameters": {
        "type": "object",
        "properties": {
          "command": { "type": "string" },
          "args": {
            "type": "array",
            "items": {
              "type": ["string", "number", "boolean"]
            }
          },
          "timeoutMs": { "type": "number" }
        },
        "required": ["command"]
      }
    },
    {
      "key": "execute",
      "name": "execute",
      "file": "execute.md",
      "risk": "external",
      "parameters": {
        "type": "object",
        "properties": {
          "cwd": { "type": "string" },
          "mode": { "type": "string", "enum": ["serial", "parallel"] },
          "maxConcurrency": { "type": "number" },
          "tasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "runtime": { "type": "string", "enum": ["python", "sh"] },
                "path": { "type": "string" },
                "args": {
                  "type": "array",
                  "items": {
                    "type": ["string", "number", "boolean"]
                  }
                },
                "cwd": { "type": "string" },
                "env": { "type": "object" },
                "timeoutMs": { "type": "number" }
              },
              "required": ["runtime", "path"]
            }
          }
        },
        "required": ["tasks"]
      }
    }
  ]
}
