{
    // EN: Static constitution package version. Runtime does not write this package.
    // ZH: 静态宪章包版本。运行时不写入该包。
    "version": 1,
    // EN: Human-readable note set description.
    // ZH: 面向人的记录集描述。
    "description": "Static assistant constitution and capability template.",
    // EN: Files loaded into ordinary assistant messages.
    // ZH: 会加载进普通助手消息的文件。
    "prompt": {
        "sections": [
            "SOUL",
            "EXTENSION"
        ]
    },
    // EN: Static package policy; runtime writes are disabled.
    // ZH: 静态包策略；运行时写入已禁用。
    "protocolPackage": {
        // EN: No runtime writes are enabled in the session-less organism.
        // ZH: 无 session 生命体不启用运行时写入。
        "editable": [],
        // EN: Files that can be read for rules but must not be rewritten.
        // ZH: 可读取规则但禁止重写的文件。
        "locked": [
            "AGENTS.md"
        ],
        // EN: Files not loaded into ordinary assistant messages.
        // ZH: 不加载进普通助手消息的文件。
        "runtimeIgnored": [
            "config.jsonc",
            "AGENTS.md",
            "AGENTS.zh.cn.md",
            "USER.md",
            "SOUL.zh.cn.md",
            "USER.zh.cn.md",
            "EXTENSION.zh.cn.md"
        ],
        // EN: XML documents supplied when planning note updates.
        // ZH: 规划记录更新时提供的 XML 文档。
        "context": {
            // EN: Root XML tag.
            // ZH: XML 根标签。
            "root": "prompt_package",
            // EN: Ordered documents included for update planning.
            // ZH: 更新规划时按顺序包含的文档。
            "blocks": [
                {
                    "key": "config",
                    "tag": "document",
                    "file": "config.jsonc",
                    "role": "policy",
                    "note": "file list and write limits"
                },
                {
                    "key": "AGENTS",
                    "tag": "document",
                    "file": "AGENTS.md",
                    "role": "rules",
                    "note": "update rules"
                },
                {
                    "key": "SOUL",
                    "tag": "document",
                    "file": "SOUL.md",
                    "role": "assistant_notes",
                    "note": "assistant identity, style, boundaries, and mission"
                },
                {
                    "key": "USER",
                    "tag": "document",
                    "file": "USER.md",
                    "role": "user_notes",
                    "note": "user profile, preferences, expertise, goals, and communication"
                },
                {
                    "key": "EXTENSION",
                    "tag": "document",
                    "file": "EXTENSION.md",
                    "role": "capabilities",
                    "note": "available abilities, workflows, and limits"
                }
            ]
        }
    }
}
