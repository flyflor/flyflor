{
    // Flyflor global config. Copy to ~/.flyflor/config.jsonc.
    "model": {
        // Custom relay profiles can use any provider id, e.g. custom, xxxai, fastai.
        // Defaults are OpenAI-compatible; protocol/baseUrl are normalized automatically.
        "activeProvider": "custom",
        "activeModel": "gpt-5.5",
        "temperature": 0.2,
        "timeoutMs": 60000,
        "secrets": {
            "custom-api-key": "",
        },
        "providers": {
            // Built-ins are reserved by convention and only need overrides.
            // openai, claude, anthropic, deepseek, gemini, kimi, minimax,
            // minimax-cn, qwen, qwen-intl, openrouter, ai-gateway, xai,
            // zai, groq, mistral, azure-openai, bedrock, ollama, local, custom.
            "openai": {},
            "claude": {},
            "deepseek": {},
            "gemini": {},
            "kimi": {},
            "minimax": {},
            "qwen": {},
            "openrouter": {},
            "custom": {
                "type": "openai-compatible",
                "baseUrl": "",
                "apiKey": "custom-api-key",
                "defaultModel": "",
                "models": [],
            },
        },
    },
    "gateway": {
        "host": "0.0.0.0",
        "port": 8787,
        "stdio": false,
        "allowedChannels": ["api", "webhook", "stdio"],
        "channelReplyUrls": {},
        "channels": {
            "api": {},
            "bluebubbles": {
                // BlueBubbles/iMessage bridge.
                // "serverUrl": "http://127.0.0.1:1234",
                // "password": "",
            },
            "dingtalk": {
                // "webhookUrl": "",
                // "accessToken": "",
                // "secret": "",
            },
            "email": {
                // Native SMTP/IMAP bridge can be configured later; replyUrl works today.
                // "replyUrl": "",
            },
            "homeassistant": {
                // "url": "http://homeassistant.local:8123",
                // "accessToken": "",
            },
            "imessage": {
                // Uses the same BlueBubbles bridge shape.
                // "serverUrl": "http://127.0.0.1:1234",
                // "password": "",
            },
            "line": {
                // "channelAccessToken": "",
                // "channelSecret": "",
            },
            "mattermost": {
                // "baseUrl": "",
                // "botToken": "",
            },
            "matrix": {
                // "homeserverUrl": "",
                // "accessToken": "",
                // "userId": "",
            },
            "qq": {
                "sandbox": false,
            },
            "signal": {
                // "restUrl": "http://127.0.0.1:8080",
                // "number": "",
            },
            "slack": {
                // "botToken": "",
                // "signingSecret": "",
            },
            "sms": {
                // "replyUrl": "",
            },
            "telegram": {},
            "discord": {},
            "feishu": {},
            "wechat": {
                // WeChat must use iLink. Configure weixinIlink below and enable "wechat" or "weixin-ilink".
            },
            "wecom": {
                // "token": "",
            },
            "whatsapp": {
                // "accessToken": "",
                // "phoneNumberId": "",
                // "verifyToken": "",
            },
            "weixinIlink": {
                // iLink personal WeChat protocol.
                // The init wizard can bind via QR and prefill apiBaseUrl/token.
                // "apiBaseUrl": "https://ilinkai.weixin.qq.com",
                // "token": "",
                // "baseInfo": { "channel_version": "2.2.0" },
                "pollIntervalMs": 1500,
            },
            "zalo": {
                // "replyUrl": "",
                // "accessToken": "",
            },
        },
    },
    "memory": {
        "analyzer": {
            "enabled": true,
            "candidateThreshold": 0.65,
            "keyphraseLimit": 12,
            "minimumTextChars": 4,
        },
        "enabled": true,
        "candidates": {
            "autoPromoteExplicit": true,
            "maxCandidatesPerTurn": 3,
        },
        "matrix": {
            "enabled": true,
            "maxSourceChars": 4096,
            "maxTokens": 128,
            "naturalSentiment": true,
        },
        "markdown": {
            "enabled": true,
            "maxPromptChars": 12000,
        },
        "sqlite": {
            "enabled": true,
            "maxPromptItems": 8,
        },
        "qdrant": {
            // Qdrant is Flyflor internal infrastructure. Do not expose it as a public endpoint.
            // Docker dev resolves this service name internally; native installer will manage a local endpoint.
            "enabled": true,
            "internalUrl": "http://qdrant:6333",
            "collection": "flyflor_memories",
            "dimensions": 384,
            "timeoutMs": 1500,
        },
        "crystal": {
            // SurrealDB is Flyflor internal Crystal Memory infrastructure. Do not expose it as a public endpoint.
            "enabled": false,
            "surreal": {
                "enabled": true,
                "internalUrl": "http://127.0.0.1:8000",
                "namespace": "flyflor",
                "database": "flyflor",
            },
        },
        "retrieval": {
            "maxResults": 12,
            "maxPromptChars": 18000,
        },
        "session": {
            "consolidationBatchSize": 24,
            "maxHistoryEntryChars": 8000,
            "maxLiveMessages": 80,
            "maxPromptMessages": 16,
        },
        "weights": {
            "actionability": 0.7,
            "arousal": 0.5,
            "certainty": 0.65,
            "importance": 0.85,
            "confidence": 1,
            "durability": 0.65,
            "dominance": 0.5,
            "emotionalValence": 0,
            "recurrence": 1,
            "relevance": 0.8,
            "sourceDiversity": 1,
            "validationCount": 1,
        },
    },
    "sandbox": {
        "mode": "off",
        "mcpToolApproval": "deny",
        "shellHookApproval": "deny",
        "pluginApproval": "deny",
    },
}
