{
    "name": "flyflor-front",
    "type": "module",
    "private": true,
    "scripts": {
        "build": "bun --bun node_modules/.bin/nuxt build",
        "check": "bun --bun node_modules/.bin/nuxt typecheck && bun run scripts/redlines.check.ts",
        "dev": "bun --bun node_modules/.bin/nuxt dev",
        "generate": "bun --bun node_modules/.bin/nuxt generate",
        "preview": "bun --bun node_modules/.bin/nuxt preview",
        "postinstall": "bun --bun node_modules/.bin/nuxt prepare",
        "redlines:check": "bun run scripts/redlines.check.ts"
    },
    "devDependencies": {
        "@types/bun": "^1.3.14",
        "vue-tsc": "^3.1.8"
    },
    "dependencies": {
        "@nuxt/icon": "^2.1.0",
        "@iconify-json/lucide": "^1.2.94",
        "nuxt": "^4.4.5",
        "typescript": "^5.9.3",
        "vue": "^3.5.34",
        "vue-router": "^5.0.6"
    }
}
