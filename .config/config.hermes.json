{
    "model": {
        "default": "deepseek-chat",
        "model": "deepseek-chat",
        "provider": "deepseek",
        "api_key_env": "DEEPSEEK_API_KEY",
        "base_url": "https://api.deepseek.com",
        "auth_mode": "api_key",
        "entra": {
            "scope": "https://ai.azure.com/.default"
        },
        "context_length": 131072,
        "max_tokens": 8192
    },
    "providers": {
        "deepseek": {
            "request_timeout_seconds": 1800,
            "stale_timeout_seconds": 300,
            "models": {
                "deepseek-chat": {
                    "timeout_seconds": 600,
                    "stale_timeout_seconds": 900
                }
            }
        },
        "anthropic": {
            "request_timeout_seconds": 900,
            "stale_timeout_seconds": 300,
            "models": {
                "claude-opus-4.6": {
                    "timeout_seconds": 600,
                    "stale_timeout_seconds": 1800
                }
            }
        },
        "openai-codex": {
            "request_timeout_seconds": 1800,
            "stale_timeout_seconds": 1800,
            "models": {
                "gpt-5.4": {
                    "timeout_seconds": 1800,
                    "stale_timeout_seconds": 1800
                }
            }
        }
    },
    "provider_routing": {
        "sort": "throughput",
        "only": [],
        "ignore": [],
        "order": [],
        "require_parameters": false,
        "data_collection": "allow"
    },
    "openrouter": {
        "response_cache": true,
        "response_cache_ttl": 300
    },
    "worktree": false,
    "terminal": {
        "backend": "local",
        "cwd": ".",
        "timeout": 180,
        "docker_mount_cwd_to_workspace": false,
        "lifetime_seconds": 300,
        "sudo_password": "",
        "ssh_host": "",
        "ssh_user": "",
        "ssh_port": 22,
        "ssh_key": "",
        "docker_image": "nikolaik/python-nodejs:python3.11-nodejs20",
        "docker_run_as_host_user": true,
        "docker_forward_env": [],
        "docker_extra_args": [],
        "singularity_image": "docker://nikolaik/python-nodejs:python3.11-nodejs20",
        "modal_image": "nikolaik/python-nodejs:python3.11-nodejs20",
        "daytona_image": "nikolaik/python-nodejs:python3.11-nodejs20",
        "container_cpu": 1,
        "container_memory": 5120,
        "container_disk": 51200,
        "container_persistent": true
    },
    "security": {
        "tirith_enabled": false,
        "tirith_path": "tirith",
        "tirith_timeout": 5,
        "tirith_fail_open": true
    },
    "browser": {
        "inactivity_timeout": 120
    },
    "tool_loop_guardrails": {
        "warnings_enabled": true,
        "hard_stop_enabled": false,
        "warn_after": {
            "exact_failure": 2,
            "same_tool_failure": 3,
            "idempotent_no_progress": 2
        },
        "hard_stop_after": {
            "exact_failure": 5,
            "same_tool_failure": 8,
            "idempotent_no_progress": 5
        }
    },
    "compression": {
        "enabled": true,
        "threshold": 0.5,
        "target_ratio": 0.2,
        "protect_last_n": 20,
        "protect_first_n": 3
    },
    "prompt_caching": {
        "cache_ttl": "5m"
    },
    "auxiliary": {
        "vision": {
            "provider": "auto",
            "model": "",
            "timeout": 30,
            "download_timeout": 30,
            "max_concurrency": 3,
            "extra_body": {}
        },
        "web_extract": {
            "provider": "auto",
            "model": "",
            "timeout": 30,
            "download_timeout": 30,
            "max_concurrency": 3,
            "extra_body": {}
        },
        "session_search": {
            "provider": "auto",
            "model": "",
            "timeout": 30,
            "download_timeout": 30,
            "max_concurrency": 3,
            "extra_body": {}
        },
        "compression": {
            "provider": "auto",
            "model": "",
            "timeout": 60,
            "download_timeout": 30,
            "max_concurrency": 1,
            "extra_body": {}
        }
    },
    "memory": {
        "memory_enabled": true,
        "user_profile_enabled": true,
        "memory_char_limit": 2200,
        "user_char_limit": 1375,
        "nudge_interval": 10,
        "flush_min_turns": 6
    },
    "session_reset": {
        "mode": "both",
        "idle_minutes": 1440,
        "at_hour": 4,
        "notify": true,
        "notify_exclude_platforms": ["api_server", "webhook"]
    },
    "group_sessions_per_user": true,
    "streaming": {
        "enabled": false,
        "transport": "edit",
        "edit_interval": 0.3,
        "buffer_threshold": 40,
        "cursor": " ▉"
    },
    "skills": {
        "directory": "./.config/skills",
        "creation_nudge_interval": 15,
        "external_dirs": []
    },
    "agent": {
        "max_turns": 60,
        "gateway_timeout": 1800,
        "gateway_timeout_warning": 900,
        "restart_drain_timeout": 60,
        "api_max_retries": 3,
        "verbose": false,
        "reasoning_effort": "medium",
        "personalities": {
            "helpful": "You are a helpful, friendly AI assistant.",
            "concise": "You are a concise assistant. Keep responses brief and to the point.",
            "technical": "You are a technical expert. Provide detailed, accurate technical information.",
            "creative": "You are a creative assistant. Think outside the box and offer innovative solutions.",
            "teacher": "You are a patient teacher. Explain concepts clearly with examples."
        }
    },
    "agents": {
        "main": {
            "name": "main",
            "description": "Default Flyflor agent for direct user turns.",
            "role": "agent",
            "model": "deepseek-chat",
            "provider": "deepseek",
            "base_url": "https://api.deepseek.com",
            "prompt": "agent.md",
            "personality": "helpful",
            "toolsets": ["flyflor-cli"],
            "mcp_servers": [],
            "max_turns": 60,
            "enabled": true
        },
        "orchestrator": {
            "name": "orchestrator",
            "description": "Coordinator agent for multi-agent planning and delegation.",
            "role": "orchestrator",
            "model": "deepseek-chat",
            "provider": "deepseek",
            "base_url": "https://api.deepseek.com",
            "prompt": "agent.md",
            "personality": "technical",
            "toolsets": ["todo", "delegate", "mcp"],
            "mcp_servers": [],
            "max_turns": 80,
            "enabled": false
        },
        "coder": {
            "name": "coder",
            "description": "Worker agent for code editing, shell execution, and repo inspection.",
            "role": "worker",
            "model": "deepseek-chat",
            "provider": "deepseek",
            "base_url": "https://api.deepseek.com",
            "prompt": "agent.md",
            "personality": "technical",
            "toolsets": ["terminal", "file", "search", "todo"],
            "mcp_servers": [],
            "max_turns": 50,
            "enabled": false
        },
        "researcher": {
            "name": "researcher",
            "description": "Worker agent for web research, source gathering, and summarization.",
            "role": "worker",
            "model": "deepseek-chat",
            "provider": "deepseek",
            "base_url": "https://api.deepseek.com",
            "prompt": "agent.md",
            "personality": "concise",
            "toolsets": ["web", "browser", "vision", "todo"],
            "mcp_servers": [],
            "max_turns": 40,
            "enabled": false
        }
    },
    "platform_toolsets": {
        "cli": ["flyflor-cli"],
        "ipc": ["flyflor-cli"],
        "telegram": ["hermes-telegram"],
        "discord": ["hermes-discord"],
        "whatsapp": ["hermes-whatsapp"],
        "slack": ["hermes-slack"],
        "signal": ["hermes-signal"],
        "homeassistant": ["hermes-homeassistant"],
        "qqbot": ["hermes-qqbot"],
        "yuanbao": ["hermes-yuanbao"],
        "teams": ["hermes-teams"],
        "google_chat": ["hermes-google_chat"]
    },
    "platforms": {
        "telegram": {
            "reply_to_mode": "first",
            "guest_mode": false,
            "allowed_chats": [],
            "extra": {
                "disable_link_previews": false
            }
        },
        "ipc": {
            "reply_to_mode": "off",
            "guest_mode": false,
            "allowed_chats": [],
            "extra": {
                "socket": "./flyflor.sock"
            }
        }
    },
    "discord": {
        "require_mention": true,
        "auto_thread": true,
        "free_response_channels": "",
        "reactions": true,
        "history_backfill": true,
        "history_backfill_limit": 50
    },
    "mcp_servers": {
        "time": {
            "enabled": false,
            "command": "uvx",
            "args": ["mcp-server-time"],
            "env": {},
            "url": "",
            "headers": {},
            "timeout": 120,
            "connect_timeout": 60,
            "sampling": {
                "enabled": true,
                "model": "deepseek-chat",
                "max_tokens_cap": 4096,
                "timeout": 30,
                "max_rpm": 10,
                "allowed_models": [],
                "max_tool_rounds": 5,
                "log_level": "info"
            }
        },
        "filesystem": {
            "enabled": false,
            "command": "npx",
            "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
            "env": {},
            "url": "",
            "headers": {},
            "timeout": 120,
            "connect_timeout": 60,
            "sampling": {
                "enabled": true,
                "model": "deepseek-chat",
                "max_tokens_cap": 4096,
                "timeout": 30,
                "max_rpm": 10,
                "allowed_models": [],
                "max_tool_rounds": 5,
                "log_level": "info"
            }
        },
        "notion": {
            "enabled": false,
            "command": "",
            "args": [],
            "env": {},
            "url": "https://mcp.notion.com/mcp",
            "headers": {},
            "timeout": 120,
            "connect_timeout": 60,
            "sampling": {
                "enabled": true,
                "model": "deepseek-chat",
                "max_tokens_cap": 4096,
                "timeout": 30,
                "max_rpm": 10,
                "allowed_models": [],
                "max_tool_rounds": 5,
                "log_level": "info"
            }
        }
    },
    "stt": {
        "enabled": false,
        "provider": "local",
        "local": {
            "model": "base",
            "language": ""
        },
        "openai": {
            "model": "whisper-1"
        },
        "mistral": {
            "model": "voxtral-mini-latest"
        }
    },
    "human_delay": {
        "mode": "off",
        "min_ms": 800,
        "max_ms": 2500
    },
    "code_execution": {
        "timeout": 300,
        "max_tool_calls": 50
    },
    "delegation": {
        "max_iterations": 50,
        "max_concurrent_children": 3,
        "max_spawn_depth": 1,
        "orchestrator_enabled": true,
        "subagent_auto_approve": false,
        "inherit_mcp_toolsets": true,
        "model": "",
        "provider": ""
    },
    "honcho": {},
    "display": {
        "compact": false,
        "tool_progress": "all",
        "cleanup_progress": false,
        "interim_assistant_messages": true,
        "busy_input_mode": "interrupt",
        "background_process_notifications": "all",
        "bell_on_complete": false,
        "show_reasoning": false,
        "streaming": true,
        "timestamps": false,
        "skin": "default",
        "platforms": {
            "telegram": {
                "cleanup_progress": false
            }
        }
    },
    "model_aliases": {
        "deepseek": {
            "model": "deepseek-chat",
            "provider": "deepseek",
            "base_url": "https://api.deepseek.com"
        },
        "opus": {
            "model": "claude-opus-4-6",
            "provider": "anthropic",
            "base_url": "https://api.anthropic.com/v1"
        },
        "qwen": {
            "model": "qwen3.5:397b",
            "provider": "custom",
            "base_url": "https://ollama.com/v1"
        },
        "glm": {
            "model": "glm-4.7",
            "provider": "custom",
            "base_url": "https://ollama.com/v1"
        }
    },
    "privacy": {
        "redact_pii": false
    },
    "hooks": {
        "pre_tool_call": [],
        "post_tool_call": [],
        "pre_llm_call": [],
        "post_llm_call": [],
        "pre_api_request": [],
        "post_api_request": [],
        "on_session_start": [],
        "on_session_end": [],
        "on_session_finalize": [],
        "on_session_reset": [],
        "subagent_stop": []
    },
    "hooks_auto_accept": false,
    "runtime": {
        "mode": "fast"
    },
    "llm": {
        "defaultProvider": "deepseek",
        "providers": {
            "deepseek": {
                "baseURL": "https://api.deepseek.com",
                "apiKeyEnv": "DEEPSEEK_API_KEY",
                "defaultModel": "deepseek-chat",
                "models": ["deepseek-chat"]
            }
        }
    },
    "sandbox": {
        "defaultDecision": "allow"
    },
    "storage": {
        "schemaDirectory": "./sql"
    },
    "mcp": {
        "servers": {}
    }
}
