    //         },
    //     },
    //     "bedrock": {
    //         "requestTimeoutSeconds": 60,
    //         "staleTimeoutSeconds": 30,
    //         "protocols": [
    //             { "name": "awsBedrockConverse", "baseUrl": "https://bedrock-runtime.us-east-1.amazonaws.com" },
    //         ],
    //         "models": {
    //             "anthropic.claude-sonnet-4-5-20250929-v1:0": {
    //                 "timeoutSeconds": 60,
    //                 "staleTimeoutSeconds": 30,
    //             },
    //         },
    //     },
    //     "cohere": {
    //         "requestTimeoutSeconds": 60,
    //         "staleTimeoutSeconds": 30,
    //         "protocols": [
    //             { "name": "cohereChat" },
    //         ],
    //         "models": {
    //             "command-r-plus": {
