{
    // Flyflor uses one JSONC config file. Secrets stay in environment variables, never in this file.
    // The IPC socket path is a convention (./flyflor.sock), not configuration — see ConfigComponent.socketEndpoint.
    "runtime": {
        "mode": "fast",
    },
    "llm": {
        "defaultProvider": "deepseek",
        "providers": {
            "deepseek": {
                "baseURL": "https://api.deepseek.com",
                "apiKeyEnv": "DEEPSEEK_API_KEY",
                "defaultModel": "deepseek-chat",
                "models": [
                    "deepseek-chat"
                ],
            },
        },
    },
    "sandbox": {
        "defaultDecision": "allow",
    },
    "storage": {
        "schemaDirectory": "./sql",
    },
    // External capabilities (optional). Skills are directory-based; MCP servers use stdio (command/args) or url.
    "skills": {
        "directory": "./.config/skills",
    },
    "mcp": {
        "servers": {},
    },
}