{
    // Flyflor 单一运行时配置文件。
    // 约定：
    // - 密钥只放环境变量，不写入本文件。
    // - 代码已有默认值、通常不需要改的配置项保留为注释示例。
    // - 需要运行时明确选择的模型与 provider 保持启用。
    // 当前默认模型配置。
    // default: 对外语义上的默认模型名。
    // model: 当前实际调用的模型名。
    // provider: providers 中的 provider key。
    // apiKeyEnv: 读取 API key 的环境变量名。
    // baseUrl: OpenAI-compatible 接口根地址。
    // protocols: 当前模型按顺序尝试的协议数组。
    //   - name: 协议名。
    //   - enabled: false 时跳过该协议。
    //   - baseUrl: 覆盖 model.baseUrl。
    //   - apiKeyEnv: 覆盖 model.apiKeyEnv。
    //   - path: 协议 endpoint path，支持 {model} 模板。
    //   - auth: 鉴权模式，支持 bearer / optionalBearer / anthropic / google / none。
    //   - version: 某些协议需要的显式版本号，例如 Anthropic Messages。
    //   - usesV1Fallback: true 时额外尝试 baseUrl + /v1。
    //   - acceptsJsonStream: true 时把 application/json 响应当作流式 JSON 行处理。
    //   - acceptsJsonResponse: true 时允许 application/json 非流式响应折叠为文本流。
    //   - missingTerminalMessage: 流结束但没有协议终止事件时的错误信息。
    // 默认注册表支持：
    //   - anthropicMessages
    //   - openaiResponses
    //   - googleGeminiGenerateContent
    //   - awsBedrockConverse
    //   - cohereChat
    //   - huggingFace
    //   - ollama
    //   - vllm
    //   - lmStudio
    //   - openaiChatCompletions
    // entra: Entra ID 鉴权参数；authMode=entraId 时使用。
    // contextLength: 模型上下文窗口长度。
    // maxTokens: 单次生成最大 token 数。
    "model": {
        "default": "deepseek-v4-flash",
        "model": "deepseek-v4-flash",
        "provider": "deepseek",
        "apiKeyEnv": "DEEPSEEK_API_KEY",
        "baseUrl": "https://api.deepseek.com",
        "protocols": [
            {
                "name": "openaiChatCompletions",
                "path": "/chat/completions",
                "auth": "bearer",
                "usesV1Fallback": true,
                "missingTerminalMessage": "LLM provider stream ended without a structured finish_reason"
            },
            {
                "name": "openaiResponses",
                "path": "/responses",
                "auth": "bearer",
                "usesV1Fallback": true,
                "acceptsJsonResponse": true,
                "missingTerminalMessage": "LLM provider stream ended without a structured response terminal event"
            },
        ],
        "entra": {},
        "contextLength": 131072,
        "maxTokens": 8192,
    },
    // 常见协议数组写法示例：
    // "model": {
