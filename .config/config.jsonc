{
    // Protocol, path, authentication, and wire parsing are provider conventions
    // under src/model/protocol. Secrets stay in environment variables.
    // Agent prompt paths are directory conventions:
    //   .config/agents/{name}/  or  prompts/agents/{name}.md
    "model": {
        "model": "deepseek-v4-flash",
        "provider": "deepseek",
        "baseUrl": "https://api.deepseek.com",
        "apiKeyEnv": "DEEPSEEK_API_KEY",
        "timeoutSeconds": 60,
    },
    "agent": "flyflor",
    "agents": {
        "flyflor": { "maxTokens": 8192 },
        "worker": {},
        "reviewer": {},
    },
    "socket": "./flyflor.sock",
}
