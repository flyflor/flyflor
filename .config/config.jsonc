{
    // Protocol, path, authentication, and wire parsing are provider conventions
    // under src/model/protocol. Secrets stay in environment variables.
    "model": {
        "model": "deepseek-v4-flash",
        "provider": "deepseek",
        "baseUrl": "https://api.deepseek.com",
        "apiKeyEnv": "DEEPSEEK_API_KEY",
        "timeoutSeconds": 60,
    },
    "agent": "flyflor",
    "agents": {
        "flyflor": {
            "name": "flyflor",
            "model": "deepseek-v4-flash",
            "provider": "deepseek",
            "contextLength": 131072,
            "maxTokens": 8192,
            "promptPackage": "./.config/agents/flyflor",
            "promptSections": ["SOUL", "USER", "EXTENSION"],
        },
        "worker": {
            "name": "worker",
            "model": "deepseek-v4-flash",
            "provider": "deepseek",
            "contextLength": 131072,
            "maxTokens": 8192,
            "promptPackage": "./prompts/agents",
            "promptSections": ["worker"],
        },
        "reviewer": {
            "name": "reviewer",
            "model": "deepseek-v4-flash",
            "provider": "deepseek",
            "contextLength": 131072,
            "maxTokens": 8192,
            "promptPackage": "./prompts/agents",
            "promptSections": ["reviewer"],
        },
    },
    "socket": "./flyflor.sock",
}
