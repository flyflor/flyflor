    // Canonical repo-relative locations Flyflor reads/writes at runtime.
    // All paths are relative (rule 7) and resolved against `rootPath` via `resolveFromRoot()` in `paths.ts`.
    // - `configFile`: the single JSONC config file, needed to bootstrap config loading before config is known.
    // - `promptsDir`: directory holding canonical `<name>.md` prompt sources.
    // - `sqlDir`: directory holding `NNN-*.sql` schema-init scripts.
    "promptsDir": "./prompts",
    "sqlDir": "./sql",
    // 长期记忆和用户画像写入在当前研发阶段关闭。
    // 若迁移配置仍包含 memory block，ConfigService 会忽略它。
    // 单一心智的人格提示词包配置。
    // promptPackage: 人格 section（SOUL/AGENTS/EXTENSION/USER）所在目录。
    // promptSections: 启用哪些 section；缺省为 ["SOUL", "EXTENSION"]。
    "persona": {
        "promptPackage": "./.config/persona",
    },
    // IPC socket 路径。
    // 默认值为 ./flyflor.sock；通常不需要配置。
    // Windows 运行时内部会转换为命名管道。
    "socket": "./flyflor.sock",
    // Skill 插件目录配置。
    // directory: skill 根目录。
    // creationNudgeInterval: skill 创建提示间隔。
    // externalDirs: 额外 skill 搜索目录。
    // ConfigService 中已有默认值；需要自定义 skill 目录时取消注释。
    // "skills": {
    //     "directory": "./.config/skills",
    //     "creationNudgeInterval": 15,
    //     "externalDirs": [],
    // },
    // MCP server 配置。
    // servers: MCP server 列表，key 为 server 名称。
    // command: stdio server 启动命令。
    // args: stdio server 启动参数。
    // env: 传给 server 进程的环境变量覆盖。
    // url: 预留给 http/sse transport。
    // 当前没有 MCP server 时不需要启用。
    // "mcp": {
    //     "servers": {
    //         "example": {
    //             "command": "node",
    //             "args": ["./server.js"],
    //             "env": {},
    //             "url": "",
    //         },
    //     },
    // },
}
