    // Provider 列表，key 必须能被 model.provider 引用。
    // requestTimeoutSeconds: provider 默认请求超时秒数。
    // staleTimeoutSeconds: provider 默认空闲/卡住判定秒数。
    // models: provider 下每个模型的细粒度覆盖配置。
    // protocols: provider 级协议数组；配置后覆盖 model.protocols。
    // timeoutSeconds: 单模型请求超时秒数。
    // staleTimeoutSeconds: 单模型空闲/卡住判定秒数。
    "providers": {
        "deepseek": {
            "requestTimeoutSeconds": 60,
            "staleTimeoutSeconds": 30,
            "models": {
                "deepseek-v4-flash": {
                    "timeoutSeconds": 60,
                    "staleTimeoutSeconds": 30,
                },
            },
        },
    },
