{
    "name": "flyflor",
    "module": "app.ts",
    "type": "module",
    "scripts": {
        "dev": "bun run --watch src/app.ts",
        "check": "bunx tsc --noEmit && bun run scripts/check.ts",
        "build:binary": "bun build --compile --outfile dist/flyflor app.ts"
    },
    "devDependencies": {
        "@types/bun": "latest"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@types/lodash-es": "^4.17.12",
        "lodash-es": "^4.18.1",
        "reflect-metadata": "^0.2.2"
    }
}
