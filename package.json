{
    "name": "flyflor",
    "module": "app.ts",
    "type": "module",
    "scripts": {
        "dev": "bun run app.ts",
        "chat": "bun run app.ts chat",
        "docker:chat": "bun run build:binary:linux-x64 && docker compose up -d flyflor && docker exec -it flyflor-dev flyflor",
        "docker:dev": "bun run build:binary:linux-x64 && docker compose up -d flyflor",
        "check": "bunx tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "build:binary": "bun build --compile --target=bun --packages=bundle --reject-unresolved --outfile dist/flyflor app.ts",
        "build:binary:docker": "bun run build:binary:linux-x64",
        "build:binary:linux-arm64": "bun build --compile --target=bun-linux-arm64 --packages=bundle --reject-unresolved --outfile dist/flyflor-linux-arm64 app.ts",
        "build:binary:linux-x64": "bun build --compile --target=bun-linux-x64 --packages=bundle --reject-unresolved --outfile dist/flyflor-linux app.ts"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/lodash-es": "^4.17.12",
        "prettier": "^3.8.3"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "lodash-es": "^4.18.1"
    }
}
