{
    "name": "flyflor",
    "module": "app.ts",
    "type": "module",
    "scripts": {
        "dev": "bun run install:templates && bun run app.ts",
        "chat": "bun run install:templates && bun run app.ts chat",
        "tui": "bun run install:templates && bun run app.ts tui",
        "init": "bun run install:templates && bun run app.ts init",
        "status": "bun run install:templates && bun run app.ts status",
        "doctor": "bun run install:templates && bun run app.ts doctor",
        "docker:chat": "bun run docker:templates && bun run build:binary:docker && docker compose up -d --force-recreate flyflor && docker exec -it flyflor-dev flyflor",
        "docker:dev": "bun run docker:templates && bun run build:binary:docker && docker compose up -d --force-recreate flyflor",
        "docker:templates": "bun run scripts/install.templates.ts --docker --force",
        "install:templates": "bun run scripts/install.templates.ts",
        "test": "bun test tests/blackboard.boundaries.test.ts tests/chat.boundaries.test.ts tests/command.boundaries.test.ts tests/memory.boundaries.test.ts tests/reflection.boundaries.test.ts tests/workers.boundaries.test.ts",
        "test:session:stress": "bun run scripts/session.stress.report.ts",
        "test:memory:stress": "bun run scripts/memory.stress.report.ts",
        "test:blackboard:stress": "bun run scripts/blackboard.routing.stress.report.ts",
        "test:reflection:stress": "bun run scripts/reflection.stress.report.ts",
        "inspect:sessions": "bun run scripts/session.inspect.ts",
        "inspect:blackboard": "bun run scripts/blackboard.inspect.ts",
        "check": "bunx tsc --noEmit",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "build:binary": "bun build --compile --target=bun --packages=bundle --reject-unresolved --outfile dist/flyflor app.ts",
        "build:binary:docker": "bun run scripts/build.docker.binary.ts",
        "build:binary:linux-arm64": "bun build --compile --target=bun-linux-arm64 --packages=bundle --reject-unresolved --outfile dist/flyflor-linux-arm64 app.ts",
        "build:binary:linux-x64": "bun build --compile --target=bun-linux-x64 --packages=bundle --reject-unresolved --outfile dist/flyflor-linux app.ts"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/lodash-es": "^4.17.12",
        "@types/markdown-it": "^14.1.2",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "prettier": "^3.8.3"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@clack/prompts": "^1.3.0",
        "cli-table3": "^0.6.5",
        "commander": "^14.0.3",
        "ink": "^7.0.2",
        "lodash-es": "^4.18.1",
        "markdown-it": "^14.1.1",
        "natural": "8.1.1",
        "picocolors": "^1.1.1",
        "react": "^19.2.6",
        "react-devtools-core": "^7.0.1",
        "react-dom": "^19.2.6"
    }
}
