{
    "name": "flyflor",
    "module": "src/bootstrap.ts",
    "type": "module",
    "scripts": {
        "dev": "bun run --watch src/bootstrap.ts",
        "client": "bun run --watch web/client.ts",
        "check": "bunx tsc --noEmit && bun run scripts/check.script.ts",
        "build:binary": "bun build --compile --outfile dist/flyflor src/bootstrap.ts"
    },
    "devDependencies": {
        "@types/bun": "latest"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "dependencies": {
        "@types/lodash-es": "^4.17.12",
        "@types/node": "^25.9.2",
        "lodash-es": "^4.18.1",
        "reflect-metadata": "^0.2.2"
    }
}
