        "expectedOutput": [
          "inputSummary",
          "outputSummary",
          "newFacts",
          "blockers",
          "risk",
          "questions",
          "answers",
          "agreement",
          "outcome",
          "openIssues",
          "proposal",
          "discussion"
        ],
        "constraints": [
          "no-tool-execution",
          "no-long-term-memory-write",
          "surface-blockers",
          "write-public-discussion-as-dialogue",
          "answer-current-round-peer-questions"
        ]
      },
